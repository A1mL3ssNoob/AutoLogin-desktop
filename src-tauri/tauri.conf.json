{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "校园网自动登录",
  "version": "0.1.5",
  "identifier": "com.autologin.campus",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "校园网自动登录",
        "width": 1080,
        "height": 740,
        "create": false,
        "visible": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
